# Copiar este archivo a `.env` (no se commitea) y ajustar valores para el entorno local.
# `docker compose up --build` lee automáticamente el `.env` de la raíz.

# ---- PostgreSQL ----
POSTGRES_DB=fotos
POSTGRES_USER=fotos
POSTGRES_PASSWORD=fotos_dev_password
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ROOT_USER=fotos_minio
MINIO_ROOT_PASSWORD=fotos_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=fotos-works

# ---- Mailhog ----
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ---- Backend (Spring Boot) ----
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me-please
JWT_SECRET=change-me-in-dev-please-use-a-long-random-string

# ---- Frontend (Angular) ----
FRONTEND_PORT=4200
